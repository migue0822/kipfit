# Copiar a despliegue/.env (cp .env.ejemplo .env) y llenar. Este archivo NUNCA se sube a GitHub.

# Dirección de Kipfit, sin https:// (un dominio de DuckDNS que apunte a la IP de este servidor).
DOMINIO=kipfit.duckdns.org

# Contraseña de la base de datos: solo letras y números. Generarla con:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Registro de empresas en la página de ingreso. Con REGISTRO_PUBLICO=no solo se registra quien tenga el
# código REGISTRO_CODIGO (vacío = nadie). Generarlo con:  openssl rand -hex 6
REGISTRO_PUBLICO=no
REGISTRO_CODIGO=

# Días de demostración de una empresa que se registre con el código (0 = sin vencimiento). Las que se
# crean desde la consola de OrdenKipu llevan los días que se escojan allí.
DEMO_DIAS=15

# Clave para que la consola de plataforma de OrdenKipu administre las empresas de Kipfit (la misma que
# KIPFIT_CLAVE en ~/erp-pyme/despliegue/.env). Generarla con:  openssl rand -hex 32
PLATAFORMA_CLAVE=

# Carpeta de OrdenKipu en el servidor (su Caddy publica a Kipfit con HTTPS).
ORDENKIPU_DIR=/home/ubuntu/erp-pyme/despliegue

# Respaldos: hora diaria (Bogotá; distinta de la de OrdenKipu), días en el servidor y en la nube.
RESPALDO_HORA=02:45
RESPALDO_DIAS=14
RESPALDO_DIAS_NUBE=60
# Destino en la nube con rclone (la misma conexión de OrdenKipu, otra carpeta), p. ej. gdrive:respaldos-kipfit.
# Vacío = solo en el servidor.
RCLONE_DESTINO=
# Opcional: URL de healthchecks.io que se visita tras cada respaldo exitoso.
RESPALDO_AVISO_URL=
